    </mxCell>
    <mxCell id="t2_ocean" value="&lt;b&gt;✓ CONFIRMED (AIS tracked)&lt;/b&gt;&lt;br&gt;Vessel: MSC GÜLSÜN&lt;br&gt;Actual ETA: Jul 4, 06:00 PST&lt;br&gt;Port clearance est: Jul 4, 14:00 PST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">

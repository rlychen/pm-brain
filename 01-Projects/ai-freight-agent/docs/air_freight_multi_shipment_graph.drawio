        <mxCell id="contract_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;verticalAlign=top;align=left;" value="&lt;b&gt;ULD Contract Layers&lt;/b&gt;" vertex="1">
          <mxGeometry height="320" width="225" x="1255" y="195" as="geometry" />
        </mxCell>
        <mxCell id="contract_text" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=top;" value="&lt;b&gt;Per air arc&lt;/b&gt; (each flight leg) carries:&#xa;&#xa;1.  &lt;b&gt;Contract ULD allocation&lt;/b&gt;&#xa;     • Hard BSA: take-or-pay every flight&#xa;     • Soft BSA: cancellable per flight&#xa;     • Per-flight cap: ULDs ≤ alloc(c,f,u)&#xa;     • Period cap: Σ ULDs ≤ alloc(c,T)&#xa;     • Pivot weight floor (min charge)&#xa;&#xa;2.  &lt;b&gt;Spot rate-card&lt;/b&gt;&#xa;     • IATA weight breaks&#xa;       N → +45 → +100 → +300 → +500 → +1000&#xa;     • No capacity cap at planning&#xa;     • Higher rate, full flexibility&#xa;&#xa;&lt;b&gt;ULD types&lt;/b&gt;:&#xa;     LD3   4.5 m³ / 1,587 kg&#xa;     LD7   11.1 m³ / 4,626 kg&#xa;     PMC   7.5 m³ / 6,804 kg&#xa;     AKE   4.5 m³ / 1,497 kg&#xa;&#xa;Fill rate cap: η ≈ 0.97 of CBM" vertex="1">
          <mxGeometry height="295" width="215" x="1265" y="215" as="geometry" />
        </mxCell>
        <mxCell id="leg_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aaaaaa;" value="" vertex="1">
          <mxGeometry height="170" width="1220" x="35" y="580" as="geometry" />
        </mxCell>
        <mxCell id="leg_shipments" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" value="&lt;b&gt;Shipments:&lt;/b&gt;  &lt;font color=&#39;#b85450&#39;&gt;● S3: TPE → NYC&lt;/font&gt;   &lt;font color=&#39;#9673A6&#39;&gt;● S2: KHH → CHI&lt;/font&gt;   &lt;font color=&#39;#d6b656&#39;&gt;● S1: HSZ → DAL&lt;/font&gt;        Each shipment&#39;s origin/destination share color.  Blue nodes = shared supply capacity." vertex="1">
          <mxGeometry height="16" width="1200" x="45" y="588" as="geometry" />
        </mxCell>
        <mxCell id="leg_arcs" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" value="&lt;b&gt;Air arcs:&lt;/b&gt;  Each arc = one flight leg.  &lt;font color=&#39;#0066cc&#39;&gt;Blue&lt;/font&gt; = same-carrier arc (within an airline&#39;s network)   &lt;font color=&#39;#cc0066&#39;&gt;Red/pink&lt;/font&gt; = interline (different carriers, must re-ULD at hub)   &lt;font color=&#39;#009933&#39;&gt;Green&lt;/font&gt; = freighter route (5Y/Atlas Air)" vertex="1">
          <mxGeometry height="16" width="1200" x="45" y="608" as="geometry" />
        </mxCell>
        <mxCell id="leg_through" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" value="&lt;b&gt;Through-flights:&lt;/b&gt;  Bold arcs = same flight number across multiple legs (same aircraft, technical stop). Example: 5Y9123 TPE→ANC→ORD is one flight in two legs (L1, L2). ULD stays on aircraft — no rehandling at intermediate stop, just refueling/crew change. Saves hub MCT (minimum connect time) and rehandling cost." vertex="1">
          <mxGeometry height="32" width="1200" x="45" y="628" as="geometry" />
        </mxCell>
        <mxCell id="leg_uld" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" value="&lt;b&gt;Arc labels:&lt;/b&gt;  Air = carrier+flight#/duration  (CI=China Airlines, BR=EVA, CX=Cathay, KA=Cathay Dragon, JL=JAL, NH=ANA, 5Y=Atlas Air freighter)   Ground = duration (or carrier/duration for trucking)" vertex="1">
          <mxGeometry height="16" width="1200" x="45" y="664" as="geometry" />
        </mxCell>
        <mxCell id="leg_cfs" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" value="&lt;b&gt;CFS&lt;/b&gt; (Container Freight Station) = forwarder warehouse where airline-owned empty ULDs are delivered, cargo is built up into ULDs, then trucked to the airline cargo terminal.  At destination CFS: ULDs broken down, individual AWBs released for final delivery." vertex="1">
          <mxGeometry height="32" width="1200" x="45" y="684" as="geometry" />
        </mxCell>
        <mxCell id="leg_ulds_aircraft" parent="1" style="text;html=1;fontSize=8;align=left;fontColor=#b85450;" value="&lt;b&gt;ULD on aircraft:&lt;/b&gt;  Freighters (B747F, 777F, 5Y A330F): full main+lower deck, supports PMC/PAG main-deck pallets + LD7/LD3. Passenger belly (B777, A350): LD3/LD7 only, ~20-40 positions per wide-body." vertex="1">
          <mxGeometry height="24" width="1200" x="45" y="720" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

    <!-- ===== CONSOLIDATION SIDEBAR ===== -->
    <mxCell id="consol_box" value="&lt;b&gt;Joint Consolidation Decision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1340" y="200" width="150" height="320" as="geometry" />
    </mxCell>
    <mxCell id="consol_text" value="&lt;b&gt;Two coupled decisions&lt;/b&gt;:&#10;&#10;1.  Shipment → Container&#10;     y_{k,c,s} ∈ {0,1}&#10;&#10;2.  Container → Sailing+Type&#10;     z_{c,s,t} ∈ {0,1}&#10;&#10;&lt;b&gt;Constraints:&lt;/b&gt;&#10;• Σ v_k·y ≤ η·V_t·z&#10;     (volume)&#10;• Σ w_k·y ≤ W_t·z&#10;     (weight)&#10;• y_k + y_k' ≤ 1&#10;     (hazmat)&#10;&#10;&lt;b&gt;Container types&lt;/b&gt;:&#10;FEU  76 m³ / 26.5t&#10;TEU  33 m³ / 24.0t&#10;Fill rate η = 0.97" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fontFamily=monospace;" vertex="1" parent="1">
      <mxGeometry x="1350" y="220" width="140" height="295" as="geometry" />
    </mxCell>

    <!-- ===== LEGEND ===== -->
    <mxCell id="leg_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aaaaaa;" vertex="1" parent="1">
      <mxGeometry x="35" y="575" width="1290" height="170" as="geometry" />
    </mxCell>
    <mxCell id="leg_shipments" value="&lt;b&gt;Shipments:&lt;/b&gt;  &lt;font color='#b85450'&gt;● S3: TPE → NYC (3 CBM, 1.2t)&lt;/font&gt;   &lt;font color='#9673A6'&gt;● S2: KHH → CHI (12 CBM, 4t)&lt;/font&gt;   &lt;font color='#d6b656'&gt;● S1: HSZ → DAL (8 CBM, 2.5t)&lt;/font&gt;        Sample: S1+S2+S3 = 23 CBM, 7.7t → fits in one FEU (76 m³, 26.5t)" style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="45" y="582" width="1270" height="16" as="geometry" />
    </mxCell>
    <mxCell id="leg_consol" value="&lt;b&gt;Consolidation example:&lt;/b&gt;  All 3 shipments routed to &lt;b&gt;KEL-CFS&lt;/b&gt;, stuffed into one FEU on &lt;b&gt;Sailing B (KEL→NYC)&lt;/b&gt;, deconsolidated at &lt;b&gt;NYC-CFS&lt;/b&gt;.  After breakdown: S3→NYC LTL, S2→CHI LTL (or trucked via inland CFS), S1→DAL LTL.  Joint y/z decisions assign each shipment to one container, each container to one sailing." style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="45" y="602" width="1270" height="32" as="geometry" />
    </mxCell>
    <mxCell id="leg_nodes" value="&lt;b&gt;Nodes:&lt;/b&gt;  Blue = shared supply (CFS, port).  &lt;b&gt;CFS&lt;/b&gt; (Container Freight Station) — at origin: consolidation (build-up); at destination: deconsolidation (breakdown). Fixed dwell β ≈ 1.5d each side." style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="45" y="638" width="1270" height="16" as="geometry" />
    </mxCell>
    <mxCell id="leg_arcs" value="&lt;b&gt;Arcs:&lt;/b&gt;  Solid = primary path   Dashed = alternative   &lt;b&gt;Bold&lt;/b&gt; = container-level move (stuffed at origin / full at destination).  &lt;b&gt;Sailing labels:&lt;/b&gt;  carrier/transit (MSC=MSC, CMG=CMA CGM, EVG=Evergreen, ONE=Ocean Network Express)." style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="45" y="658" width="1270" height="16" as="geometry" />
    </mxCell>
    <mxCell id="leg_rates" value="&lt;b&gt;Cost model:&lt;/b&gt;  NVOCC pays carrier per-container κ_s^t (FEU or TEU on sailing s) regardless of fill. Cargo charged W/M = max(CBM, kg/1000). LCL profitable when Σ shipments approach container capacity. Optimizer minimizes Σ container costs + ground arcs + surcharges." style="text;html=1;fontSize=8;align=left;fontColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="45" y="678" width="1270" height="32" as="geometry" />
    </mxCell>
    <mxCell id="leg_decomp" value="&lt;b&gt;Solver strategy:&lt;/b&gt;  Joint MILP for |K| ≤ 50; sequential decomposition (Stage 1: routing with aggregate CBM/kg capacity → Stage 2: bin-packing per sailing → Benders feasibility cuts) for larger batches. Empirical optimality gap 2–8%." style="text;html=1;fontSize=8;align=left;fontColor=#0066cc;" vertex="1" parent="1">
      <mxGeometry x="45" y="715" width="1270" height="24" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>

    <!-- ===== MODE / PRICING SIDEBAR ===== -->
    <mxCell id="modes_box" value="&lt;b&gt;Three Modes — Pricing Logic&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1290" y="195" width="290" height="395" as="geometry" />
    </mxCell>
    <mxCell id="modes_text" value="&lt;b&gt;&lt;font color='#009933'&gt;FTL (green)&lt;/font&gt;&lt;/b&gt;  ≥ 10K kg / 26 m³&#10;     per-mile × distance + fuel + acc&#10;     direct on-demand (spot)&#10;     OR scheduled (contract, allocation cap)&#10;     equipment: 53′ or 48′ dry van&#10;     fill rate η = 0.85&#10;&#10;&lt;b&gt;&lt;font color='#ff9900'&gt;PTL / Volume LTL (orange)&lt;/font&gt;&lt;/b&gt;  4.5–25K kg&#10;     per-shipment + per-mile&#10;     no terminal handling&#10;     6–18 pallets sweet spot&#10;     direct on-demand&#10;&#10;&lt;b&gt;&lt;font color='#0066cc'&gt;LTL (blue)&lt;/font&gt;&lt;/b&gt;  &amp;lt; 4.5K kg&#10;     density-class × weight-break $/CWT&#10;     min charge floor + AMC&#10;     pre-computed per shipment per arc&#10;     FAK override per shipper contract&#10;     NMFC 2025 SDS (13 density classes)&#10;     hub-and-spoke OPAQUE — model only&#10;     (carrier, SC_O, SC_D) tuples&#10;&#10;&lt;b&gt;Expected cost (all modes)&lt;/b&gt;:&#10;     c_exp = c_base ×&#10;       [1 + (1 − p_acc)(ρ_re − 1)]&#10;&#10;&lt;b&gt;Carriers (illustrative)&lt;/b&gt;:&#10;     LTL: OD, FXF, XPO, Saia, Estes&#10;     FTL: Knight, Schneider, Werner, spot&#10;     PTL: Daylight, Pilot Vol, R+L Vol" style="text;html=1;fontSize=8;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="1300" y="215" width="275" height="370" as="geometry" />
    </mxCell>

    <!-- ===== HARD REFUSAL SIDEBAR ===== -->
    <mxCell id="refuse_box" value="&lt;b&gt;LTL Hard Refusal Rules (P.6, P.7)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd6d6;strokeColor=#cc0000;fontSize=10;verticalAlign=top;align=left;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="970" y="120" width="200" height="120" as="geometry" />
    </mxCell>
    <mxCell id="refuse_text" value="LTL arc removed from A_k if:&#10;&#10;  • Linear ft > 12 (Capacity Load)&#10;  • Linear ft > 20 (refusal)&#10;  • Piece length > 8–16 ft&#10;  • Piece weight > 2,500 lb&#10;  • Total weight > 20–25K lb&#10;&#10;Why S3 ineligible: 40 lin ft &gt; 20" style="text;html=1;fontSize=8;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="980" y="142" width="180" height="95" as="geometry" />
    </mxCell>

    <!-- ===== LEGEND ===== -->
    <mxCell id="leg_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aaaaaa;" vertex="1" parent="1">
      <mxGeometry x="35" y="620" width="1240" height="245" as="geometry" />
    </mxCell>
    <mxCell id="leg_shipments" value="&lt;b&gt;Shipments:&lt;/b&gt;  &lt;font color='#b85450'&gt;● S3: ATL → NYC (24 pallets, 60 m³, 18t, Class 70)&lt;/font&gt;   &lt;font color='#9673A6'&gt;● S2: HOU → CHI (10 pallets, 18 m³, 8t, FAK 92.5)&lt;/font&gt;   &lt;font color='#d6b656'&gt;● S1: HOU → DAL (4 pallets, 2.5 m³, 1.5t, Class 50)&lt;/font&gt;" style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="45" y="628" width="1220" height="16" as="geometry" />
    </mxCell>
    <mxCell id="leg_arcs" value="&lt;b&gt;Arc colors:&lt;/b&gt;  &lt;font color='#0066cc'&gt;Blue&lt;/font&gt; = LTL (pickup → SC → linehaul → SC → delivery)   &lt;font color='#cc0066'&gt;Pink dashed&lt;/font&gt; = LTL Capacity Load (cap rate; usually pushed to PTL)   &lt;font color='#ff9900'&gt;Orange&lt;/font&gt; = PTL direct (no terminals)   &lt;font color='#009933'&gt;Green solid&lt;/font&gt; = FTL contract   &lt;font color='#009933'&gt;Green dashed&lt;/font&gt; = FTL spot" style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="45" y="648" width="1220" height="16" as="geometry" />
    </mxCell>
    <mxCell id="leg_shared" value="&lt;b&gt;Shared supply (blue nodes):&lt;/b&gt;  OD-HOU SC and FXF-HOU SC each serve both S1 and S2 (same origin city, different destinations). LTL carrier internal hub-and-spoke is opaque — model uses only (carrier, origin SC, destination SC) tuples per critique. Powell-Sheffi load planning is the carrier's internal problem; as forwarder we tender and the carrier routes." style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="45" y="668" width="1220" height="32" as="geometry" />
    </mxCell>
    <mxCell id="leg_optimal" value="&lt;b&gt;Optimal mode by shipment (cost-driven, with hard refusal):&lt;/b&gt;  S1 → LTL (Class 50 dense, ~$200 effective) | S2 → PTL or FTL contract (10 pallets too bulky for LTL — Capacity Load triggers) | S3 → FTL contract (LTL refused by linear-foot rule)" style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="45" y="702" width="1220" height="32" as="geometry" />
    </mxCell>
    <mxCell id="leg_pacc" value="&lt;b&gt;Tender acceptance (p_acc, ρ_re):&lt;/b&gt;  shown per arc. Expected cost includes re-tender markup: c_exp = c_base × [1 + (1−p_acc)(ρ_re−1)]. Example: FTL spot S3 ATL→NYC with p_acc=0.50, ρ_re=1.25 → c_exp = $3,800 × 1.125 = $4,275 (vs. nominal $3,800; vs. FTL contract $4,200 effective $4,242). Spot looks cheaper nominally but expected cost is comparable due to rejection risk." style="text;html=1;fontSize=8;align=left;verticalAlign=middle;fontColor=#0066cc;" vertex="1" parent="1">
      <mxGeometry x="45" y="736" width="1220" height="48" as="geometry" />
    </mxCell>
    <mxCell id="leg_constraints" value="&lt;b&gt;Constraints enforced:&lt;/b&gt;  Volume capacity (P.2, η=0.85) | Weight capacity (P.3) | LTL hard refusal (P.6, P.7) | LTL pickup cutoff (P.8) | Day-bucket time propagation (P.9) | MABD delivery window (P.10) | Carrier-lane service flags (P.11) | Contract FTL allocation cap (P.12) | Container-chassis equipment compat (P.14) | Slot lex-order symmetry breaking (P.15)" style="text;html=1;fontSize=8;align=left;verticalAlign=middle;fontColor=#990000;" vertex="1" parent="1">
      <mxGeometry x="45" y="786" width="1220" height="48" as="geometry" />
    </mxCell>
    <mxCell id="leg_modes_choice" value="&lt;b&gt;Multi-mode within one batch:&lt;/b&gt;  Optimizer can put S1, S2, S3 on three different modes simultaneously. Mode choice per shipment is independent (unless contract FTL allocation forces sharing). Total cost minimized across the batch." style="text;html=1;fontSize=8;align=left;verticalAlign=middle;" vertex="1" parent="1">
